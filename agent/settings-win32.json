{
  "lastChangelogVersion": "1.1.0",
  "packages": [
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/chandra447/pi-hermes-memory",
    "npm:@ff-labs/pi-fff",
    "npm:pi-web-access",
    "npm:pi-autoresearch"
  ],
  "extensions": [
    "-extensions/azure-devops-mcp/index.ts",
    "-extensions/wezterm-subagents/index.ts"
  ],
  "skills": [
    "-skills/graphify/SKILL.md",
    "-skills/zellij/SKILL.md"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "medium",
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-sonnet-5.5",
  "modelThinkingLevels": {
    "github-copilot/gpt-6-luna": "low",
    "github-copilot/claude-sonnet-5.5": "medium",
    "github-copilot/claude-opus-5.5": "high"
  },
  "enabledModels": [
    "github-copilot/gpt-6-luna",
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-opus-5.5"
  ]
}
